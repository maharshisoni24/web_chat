{
  "name": "group-chat-app",
  "version": "1.0.0",
  "description": "Real-time Group Chat Frontend (WebSocket-ready) — Load Balanced",
  "scripts": {
    "loadbalancer": "python load_balancer/balancer.py --host 0.0.0.0 --port 6000 --backends http://10.1.75.53:5202,http://10.1.75.53:5203,http://10.1.75.53:5204 --algorithm round_robin",
    "frontend": "vite --host 0.0.0.0 --port 5000",
    "app": "concurrently -n \"LB,FRONTEND\" \"npm run loadbalancer\" \"npm run frontend\"",
    "logs": "python logs.py",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "cross-env": "^7.0.3",
    "vite": "^8.2.2"
  }
}
