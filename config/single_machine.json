{
  "mode": "single_machine",
  "description": "Local development and automated simulation configuration using distinct ports on localhost",
  "load_balancer": {
    "host": "0.0.0.0",
    "port": 8000,
    "algorithm": "round_robin",
    "health_check_interval_seconds": 3,
    "health_check_timeout_seconds": 1.5,
    "retry_attempts": 2
  },
  "backends": [
    {
      "id": "Sys2-Backend-1",
      "host": "127.0.0.1",
      "port": 8001,
      "weight": 1
    },
    {
      "id": "Sys3-Backend-2",
      "host": "127.0.0.1",
      "port": 8002,
      "weight": 1
    },
    {
      "id": "Sys4-Backend-3",
      "host": "127.0.0.1",
      "port": 8003,
      "weight": 1
    }
  ],
  "experiment_workload": {
    "requests": 300,
    "concurrency": 15,
    "work_delay_ms": 25
  }
}
